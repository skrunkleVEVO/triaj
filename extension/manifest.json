{
  "manifest_version": 3,
  "name": "Triaj Companion",
  "version": "3.0.0",
  "description": "Lets the Triaj website sync Canvas and private calendars with your sign-in, and save course files to Downloads.",
  "permissions": ["storage", "scripting", "activeTab"],
  "optional_permissions": ["downloads"],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://skrunklevevo.github.io/triaj/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Triaj"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "open-triaj": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Open Triaj"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "companion@triaj.skrunklevevo.github.io",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
